# CI environment template — used by GitHub Actions to generate .env on the VPS.
# Replace placeholder values with GitHub Secrets in the workflow.

IMAGE_TAG=ci

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=
ALLOWED_ORIGINS=https://1111.tn,https://staging.1111.tn

# ── Core auth/user DB ────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=ci_db_password

# ── Retail DB ────────────────────────────────────────────────────────────
RETAIL_DB_HOST=retail-postgres
RETAIL_DB_PORT=5432
RETAIL_DB_NAME=retail_db
RETAIL_DB_USER=retail_user
RETAIL_DB_PASSWORD=ci_retail_db_password

# ── Para DB ──────────────────────────────────────────────────────────────
PARA_DB_HOST=para-postgres
PARA_DB_PORT=5432
PARA_DB_NAME=para_db
PARA_DB_USER=para_user
PARA_DB_PASSWORD=ci_para_db_password

# ── Alimentation DB ──────────────────────────────────────────────────────
ALIMENTATION_DB_HOST=alimentation-postgres
ALIMENTATION_DB_PORT=5432
ALIMENTATION_DB_NAME=alimentation_db
ALIMENTATION_DB_USER=alimentation_user
ALIMENTATION_DB_PASSWORD=ci_alimentation_db_password

# ── Fashion DB ───────────────────────────────────────────────────────────
FASHION_DB_HOST=fashion-postgres
FASHION_DB_PORT=5432
FASHION_DB_NAME=fashion_db
FASHION_DB_USER=fashion_user
FASHION_DB_PASSWORD=ci_fashion_db_password

# ── Catalog DB (frontend) ────────────────────────────────────────────────
CATALOG_DB_HOST=catalog-postgres
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=ci_catalog_db_password

# ── Auth / JWT ───────────────────────────────────────────────────────────
JWT_SECRET=ci_32_character_minimum_secret_value
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── Service URLs (gateway) ─────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth:3001
USER_SERVICE_URL=http://user:3002
RETAIL_SERVICE_URL=http://retail:3003
PARA_SERVICE_URL=http://para:3004
ALIMENTATION_SERVICE_URL=http://alimentation:3005
FASHION_SERVICE_URL=http://fashion:3007
MAILER_API_SERVICE_URL=http://mailer-api:3006
ENGAGEMENT_SERVICE_URL=http://engagement:3008
WEB_CONTROL_SERVICE_URL=http://web-control:3009
GATEWAY_INTERNAL_URL=http://gateway:3000

AUTH_PORT=3001
USER_PORT=3002
RETAIL_PORT=3003
PARA_PORT=3004
ALIMENTATION_PORT=3005
MAILER_API_PORT=3006
FASHION_PORT=3007
ENGAGEMENT_PORT=3008
WEB_CONTROL_PORT=3009
GATEWAY_PORT=3000

# ── OAuth (optional) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP ─────────────────────────────────────────────────────────────────
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=ci_smtp_password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_PATH=/app/uploads
MAX_AVATAR_SIZE_MB=5
MAX_MEDIA_SIZE_MB=8

# ── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

NODE_ENV=production
