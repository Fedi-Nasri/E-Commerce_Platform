<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <context>
    <name>1111-authenticated</name>
    <desc>Authenticated DAST context for 1111 platform</desc>
    <inscope>true</inscope>
    <urls>
      <url>http://localhost:3000</url>
      <url>http://localhost:3001</url>
    </urls>
    <includePaths>
      <path>http://localhost:3000.*</path>
      <path>http://localhost:3001.*</path>
    </includePaths>
    <excludePaths>
      <path>http://localhost:3000/api/auth/logout</path>
    </excludePaths>
    <authentication>
      <method>script</method>
      <properties>
        <entry key="scriptName">auth-script.js</entry>
      </properties>
    </authentication>
    <sessionManagement>
      <method>script_based</method>
      <properties>
        <entry key="scriptName">auth-script.js</entry>
      </properties>
    </sessionManagement>
    <users>
      <user>
        <name>demo-admin</name>
        <enabled>true</enabled>
        <credentials>
          <entry key="email">demo.admin@1111.tn</entry>
          <entry key="password">hayder14405523*</entry>
        </credentials>
      </user>
    </users>
    <tech>
      <include>JavaScript</include>
      <include>Node.js</include>
      <include>Express.js</include>
      <include>React</include>
      <include>Next.js</include>
      <include>PostgreSQL</include>
    </tech>
  </context>
</configuration>
