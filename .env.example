# Copy to .env and fill in real values. Never commit the real .env file.

# ── Image tag (bump on every release; avoid `latest` in prod) ────────────
IMAGE_TAG=v1.0.0

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
ALLOWED_ORIGINS=https://1111.tn,https://www.1111.tn

# ── Core auth/user DB ────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app_auth
DB_USER=app_auth_user
DB_PASSWORD=change_me

# ── Retail DB ────────────────────────────────────────────────────────────
RETAIL_DB_HOST=retail-postgres
RETAIL_DB_PORT=5432
RETAIL_DB_NAME=retail
RETAIL_DB_USER=retail_user
RETAIL_DB_PASSWORD=change_me

# ── Para DB ──────────────────────────────────────────────────────────────
PARA_DB_HOST=para-postgres
PARA_DB_PORT=5432
PARA_DB_NAME=para
PARA_DB_USER=para_user
PARA_DB_PASSWORD=change_me

# ── Alimentation DB ──────────────────────────────────────────────────────
ALIMENTATION_DB_HOST=alimentation-postgres
ALIMENTATION_DB_PORT=5432
ALIMENTATION_DB_NAME=alimentation
ALIMENTATION_DB_USER=alimentation_user
ALIMENTATION_DB_PASSWORD=change_me

# ── Fashion DB ───────────────────────────────────────────────────────────
FASHION_DB_HOST=fashion-postgres
FASHION_DB_PORT=5432
FASHION_DB_NAME=fashion
FASHION_DB_USER=fashion_user
FASHION_DB_PASSWORD=change_me

# ── Catalog DB (frontend) ────────────────────────────────────────────────
CATALOG_DB_HOST=catalog-postgres
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change_me

# ── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me

# ── Auth / JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change_me_minimum_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ── Service URLs (gateway) ─────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth:3001
USER_SERVICE_URL=http://user:3002
RETAIL_SERVICE_URL=http://retail:3003
PARA_SERVICE_URL=http://para:3004
ALIMENTATION_SERVICE_URL=http://alimentation:3005
FASHION_SERVICE_URL=http://fashion:3007
MAILER_API_SERVICE_URL=http://mailer-api:3006
ENGAGEMENT_SERVICE_URL=http://engagement:3008
WEB_CONTROL_SERVICE_URL=http://web-control:3009
GATEWAY_INTERNAL_URL=http://gateway:3000
ENGAGEMENT_SERVICE_URL=http://engagement:3008

# ── OAuth (optional) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP ─────────────────────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_PATH=/app/uploads
MAX_AVATAR_SIZE_MB=5
MAX_MEDIA_SIZE_MB=8

# ── Grafana (monitoring stack) ───────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
