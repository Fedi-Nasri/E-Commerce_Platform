# Copy to .env and fill in real values. Never commit the real .env file.

# ── Image tag (bump this on every release, avoid `latest` in prod) ──────
IMAGE_TAG=v1.0.0

# ── Frontend ─────────────────────────────────────────────────────────────
# Public URL clients use to reach the API through your reverse proxy
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ── Core auth/user DB ────────────────────────────────────────────────────
DB_NAME=app_auth
DB_USER=app_auth_user
DB_PASSWORD=change_me

# ── Retail DB ────────────────────────────────────────────────────────────
RETAIL_DB_NAME=retail
RETAIL_DB_USER=retail_user
RETAIL_DB_PASSWORD=change_me

# ── Para DB ──────────────────────────────────────────────────────────────
PARA_DB_NAME=para
PARA_DB_USER=para_user
PARA_DB_PASSWORD=change_me

# ── Alimentation DB ──────────────────────────────────────────────────────
ALIMENTATION_DB_NAME=alimentation
ALIMENTATION_DB_USER=alimentation_user
ALIMENTATION_DB_PASSWORD=change_me

# ── Fashion DB ───────────────────────────────────────────────────────────
FASHION_DB_NAME=fashion
FASHION_DB_USER=fashion_user
FASHION_DB_PASSWORD=change_me

# ── Catalog DB (used by the frontend) ────────────────────────────────────
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change_me

# ── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me

# ── Mailer / JWT / other service secrets go here too ────────────────────
# JWT_SECRET=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
